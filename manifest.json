{
  "manifest_version": 3,
  "name": "SF Translation Locator",
  "version": "0.2.0",
  "description": "Right-click text in Salesforce to see where its translation lives: Custom Labels, Rename Tabs and Labels, or Translation Workbench.",
  "permissions": ["contextMenus", "cookies", "scripting", "storage"],
  "host_permissions": [
    "https://*.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*"
  ],
  "action": {
    "default_title": "SF Translation Locator: open the test log"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.salesforce-setup.com/*"
      ],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
